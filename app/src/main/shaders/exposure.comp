#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// Automatic exposure: measures the centre-weighted average log luminance of the HDR frame and
// smoothly adapts the exposure toward it (eye adaptation when moving between sun and shade).
layout(local_size_x = 16, local_size_y = 16) in;

shared float sharedLum[256];
shared float sharedWeight[256];

void main() {
    uint idx = gl_LocalInvocationIndex;
    float sumLum = 0.0;
    float sumW = 0.0;
    // Each thread samples a 4x4 sub-grid; overall a 64x64 grid spread across the frame.
    for (int y = 0; y < 4; ++y) {
        for (int x = 0; x < 4; ++x) {
            vec2 cell = vec2(gl_LocalInvocationID.xy * 4u + uvec2(x, y)) + 0.5;
            vec2 uv = cell / 64.0;
            vec3 c = textureLod(hdrTexture, uv, 0.0).rgb;
            float l = max(luminance(c), 1e-4);
            vec2 d = (uv - 0.5) * vec2(1.0, 1.4);
            float w = exp(-dot(d, d) * 4.0);
            sumLum += log2(l) * w;
            sumW += w;
        }
    }
    sharedLum[idx] = sumLum;
    sharedWeight[idx] = sumW;
    barrier();
    for (uint s = 128u; s > 0u; s >>= 1u) {
        if (idx < s) {
            sharedLum[idx] += sharedLum[idx + s];
            sharedWeight[idx] += sharedWeight[idx + s];
        }
        barrier();
    }
    if (idx == 0u) {
        float avg = sharedLum[0] / sharedWeight[0];
        float target = frame.exposureParams.y / exp2(avg);
        target = clamp(target, frame.exposureParams.z, frame.exposureParams.w);
        float current = adapt.exposure;
        if (!(current > 0.0) || frame.exposureParams2.y < 0.5) {
            current = frame.exposureParams2.y < 0.5 ? 1.0 : target;
        } else {
            // Adapt in log space for perceptually even transitions.
            float k = 1.0 - exp(-frame.exposureParams.x * frame.exposureParams2.x);
            current = exp2(mix(log2(current), log2(target), k));
        }
        adapt.exposure = current;
        adapt.avgLogLum = avg;
    }
}

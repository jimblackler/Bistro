#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// GPU-driven visibility: frustum + small-feature culling of every cluster, compacting the survivors
// into per-bucket indirect draw lists consumed by vkCmdDrawIndexedIndirectCount.

layout(local_size_x = 64) in;

struct DrawCommand {
    uint indexCount;
    uint instanceCount;
    uint firstIndex;
    int vertexOffset;
    uint firstInstance;
};

layout(set = 0, binding = 3, std430) writeonly buffer DrawBuffer { DrawCommand draws[]; };
layout(set = 0, binding = 4, std430) buffer CountBuffer { uint counts[]; };

// Tests the box against the previous frame's Hi-Z pyramid (reprojected with the previous frame's
// view-projection). Conservative: anything not fully on-screen last frame is treated as visible.
bool occludedByHiZ(vec3 mn, vec3 mx) {
    if (frame.occlusionParams.w < 0.5) return false;
    vec2 smin = vec2(1e9);
    vec2 smax = vec2(-1e9);
    float nearest = 0.0;  // reversed-Z: larger is nearer
    for (int i = 0; i < 8; ++i) {
        vec3 corner = vec3((i & 1) != 0 ? mx.x : mn.x, (i & 2) != 0 ? mx.y : mn.y, (i & 4) != 0 ? mx.z : mn.z);
        vec4 c = frame.prevViewProj * vec4(corner, 1.0);
        if (c.w <= 0.1) return false;  // crosses the camera plane
        vec3 ndc = c.xyz / c.w;
        vec2 uv = ndc.xy * 0.5 + 0.5;
        smin = min(smin, uv);
        smax = max(smax, uv);
        nearest = max(nearest, ndc.z);
    }
    if (any(lessThan(smin, vec2(0.0))) || any(greaterThan(smax, vec2(1.0)))) return false;
    vec2 hizSize = frame.occlusionParams.xy;
    vec2 sizePx = (smax - smin) * hizSize;
    float level = ceil(log2(max(max(sizePx.x, sizePx.y), 1.0)));
    level = clamp(level, 0.0, frame.occlusionParams.z - 1.0);
    float d0 = textureLod(hizTexture, vec2(smin.x, smin.y), level).r;
    float d1 = textureLod(hizTexture, vec2(smax.x, smin.y), level).r;
    float d2 = textureLod(hizTexture, vec2(smin.x, smax.y), level).r;
    float d3 = textureLod(hizTexture, vec2(smax.x, smax.y), level).r;
    float farthest = min(min(d0, d1), min(d2, d3));
    return nearest < farthest;
}

void main() {
    uint id = gl_GlobalInvocationID.x;
    uint clusterCount = uint(frame.cullParams.x);
    if (id >= clusterCount) return;

    Cluster c = clusters[id];
    vec3 center = (c.aabbMin + c.aabbMax) * 0.5;
    vec3 extent = (c.aabbMax - c.aabbMin) * 0.5;

    for (int i = 0; i < 6; ++i) {
        vec4 plane = frame.frustumPlanes[i];
        float r = dot(extent, abs(plane.xyz));
        if (dot(plane.xyz, center) + plane.w < -r) return;
    }

    // Skip clusters whose bounding sphere projects to less than a pixel or so.
    float radius = length(extent);
    float dist = distance(center, frame.cameraPos.xyz) - radius;
    if (dist > 0.0 && (radius / dist) * frame.cullParams.z < frame.cullParams.w) return;

    if (occludedByHiZ(c.aabbMin, c.aabbMax)) return;

    uint capacity = uint(frame.cullParams.y);
    uint slot = atomicAdd(counts[c.bucket], 1u);
    atomicAdd(counts[3], c.indexCount / 3u);  // visible triangle statistics
    draws[c.bucket * capacity + slot] = DrawCommand(c.indexCount, 1u, c.firstIndex, c.vertexOffset, id);
}
